<?xml version="1.0" encoding="utf-8"?>
<!-- A toolbar button on a remote: the accent disc under the glyph while it has the focus, so the one
     button a press will act on is the brightest thing in the bar. Material's own state was a grey
     disc one shade off the bar - measured on the Dune's black, #151415 on #000000, which from across
     a room is no disc at all. Fixed at 40dp, the size that grey disc already had, centred in a view
     that is taller than it is wide. Touch keeps the ordinary ripple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:width="40dp"
                android:height="40dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="?attr/accentFill" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <ripple android:color="?attr/colorControlHighlight">
            <item android:id="@android:id/mask">
                <layer-list>
                    <item
                        android:width="40dp"
                        android:height="40dp"
                        android:gravity="center">
                        <shape android:shape="oval">
                            <solid android:color="@android:color/white" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </ripple>
    </item>
</selector>
